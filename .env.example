# Copy to .env.local and fill in. Vite only exposes vars prefixed VITE_ to
# client code (import.meta.env.VITE_*).
#
# Local dev values (from `supabase status` after `supabase start`):
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<ANON_KEY from `supabase status`>

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
